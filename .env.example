# ===== WOL Web 配置模板 =====
# 复制此文件为 .env 并填入你的真实值（.env 不会被提交到仓库）：
#   cp .env.example .env
# 然后编辑 .env。启动服务时程序会自动加载它。

# 目标电脑（要唤醒的 Windows/服务器）的 MAC 地址（必填）
WOL_MAC=AA:BB:CC:DD:EE:FF

# 目标电脑的 IP（用于 ping 检测在线状态）（必填）
TARGET_IP=192.168.1.100

# 管理员登录密码（必填）
ADMIN_PASSWORD=change-me

# 会话签名密钥（建议用随机字符串，例如 `openssl rand -hex 32`）
# 留空则每次启动随机生成，已登录会话在重启后失效
SECRET_KEY=

# —— 以下均为可选 ——

# WOL 广播地址（默认 255.255.255.255，通常指网段广播，例如 192.168.1.255）
# WOL_BROADCAST=255.255.255.255

# WOL 目标端口（默认 9）
# WOL_PORT=9

# 登录有效期小时数（默认 1；小数可用，0.25 = 15 分钟）
# SESSION_HOURS=0.25

# Web 监听端口（默认 5000）
# PORT=5000
